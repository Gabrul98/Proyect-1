# Copia este archivo a .env y completa los tokens (NUNCA commitear .env).
#
# Fuente primaria usada (gratuita, sin token): api.apis.net.pe/v1/ruc (espejo SUNAT)
# y datosperu.org (scraping del perfil público). No requieren token.
#
# Fallback freemium (opcional): registra UNA cuenta gratuita y pega su token.
#   apiperu.dev / api.migo.pe / factiliza / decolecta -> requieren token tipo Bearer.
APIPERU_TOKEN=
MIGO_TOKEN=
FACTILIZA_TOKEN=
DECOLECTA_TOKEN=

# Opcional: Google Places API para rating/reseñas (de lo contrario queda "no disponible públicamente")
GOOGLE_PLACES_API_KEY=
